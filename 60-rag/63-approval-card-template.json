{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "재발주 추천 승인 요청",
      "weight": "Bolder",
      "size": "Medium"
    },
    {
      "type": "Image",
      "url": "https://i.imgur.com/XXbyHnh_d.webp?maxwidth=760&fidelity=grand",
      "size": "Medium",
      "horizontalAlignment": "Center",
      "altText": "데모용 SKU 이미지 — SKU마스터 미연동, 하드코딩"
    },
    {
      "type": "TextBlock",
      "text": "${sku_code}",
      "weight": "Bolder",
      "size": "Large",
      "spacing": "None"
    },
    {
      "type": "FactSet",
      "facts": [
        {
          "title": "예측수요",
          "value": "${predicted_demand}"
        },
        {
          "title": "추천수량",
          "value": "${recommended_qty}"
        },
        {
          "title": "위험도(risk_score)",
          "value": "${risk_score}"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "승인",
      "style": "positive",
      "data": {
        "action": "approve",
        "sku_code": "${sku_code}"
      }
    },
    {
      "type": "Action.ShowCard",
      "title": "반려",
      "card": {
        "type": "AdaptiveCard",
        "body": [
          {
            "type": "TextBlock",
            "text": "반려 사유를 선택하세요",
            "wrap": true
          },
          {
            "type": "Input.ChoiceSet",
            "id": "rejection_tags",
            "isMultiSelect": true,
            "style": "expanded",
            "choices": [
              {
                "title": "#긴급승인",
                "value": "긴급승인"
              },
              {
                "title": "#생산지연",
                "value": "생산지연"
              },
              {
                "title": "#원가절감",
                "value": "원가절감"
              },
              {
                "title": "#체형스펙수정",
                "value": "체형스펙수정"
              },
              {
                "title": "#직진배송입고",
                "value": "직진배송입고"
              }
            ]
          },
          {
            "type": "Input.Text",
            "id": "rejection_text",
            "isMultiline": true,
            "placeholder": "추가로 직접 입력(선택)"
          }
        ],
        "actions": [
          {
            "type": "Action.Submit",
            "title": "반려 제출",
            "style": "destructive",
            "data": {
              "action": "reject",
              "sku_code": "${sku_code}"
            }
          }
        ]
      }
    }
  ]
}